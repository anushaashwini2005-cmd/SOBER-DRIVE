# MongoDB
MONGO_URI=mongodb://localhost:27017
DB_NAME=saferide

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS - React frontend origin
FRONTEND_ORIGIN=http://localhost:5173

# Demo mode - shortens the no-response grace period so the escalation flow
# can be demoed quickly. The backend still uses expires_at/server time as
# the source of truth either way.
DEMO_MODE=true
DEMO_TIMER_SECONDS=5

# Default safety timer used when DEMO_MODE=false and no timer is specified
DEFAULT_TIMER_MINUTES=30
